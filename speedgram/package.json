{
  "name": "speedgram",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "protocol:build": "./scripts/build-protocol.sh",
    "protocol:test": "cd protocol && uv run --python 3.12 pytest",
    "test": "npm run test:ui && npm run protocol:test && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "vitest run",
    "tauri": "tauri",
    "app": "npm run tauri -- build --debug --bundles app && rm -rf outputs/SpeedGram.app && mkdir -p outputs && cp -R src-tauri/target/debug/bundle/macos/SpeedGram.app outputs/"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-brands-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@tauri-apps/api": "^2.11.1",
    "axios": "^1.18.1",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "framer-motion": "^11.3.24",
    "js-cookie": "^3.0.8",
    "lucide-react": "^0.424.0",
    "notyf": "^3.10.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "react-transition-group": "^4.4.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
